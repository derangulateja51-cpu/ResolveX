      "name": "AUTH",
      "item": [
        {
          "name": "1.1 Successful Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains token and student role\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var token = jsonData.token || (jsonData.data && jsonData.data.token);",
                  "    pm.expect(token).to.be.a('string');",
                  "    pm.environment.set(\"userToken\", token);",
                  "    var user = jsonData.user || (jsonData.data && jsonData.data.user);",
                  "    if (user && user.role) {",
                  "        pm.expect(user.role).to.eql('student');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@resolvex.edu\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
