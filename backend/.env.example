# IssueHub Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/issuehub

# Authentication & Security
JWT_SECRET=issuehub_production_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Server-Side for AI Intake)
# If omitted, system seamlessly falls back to built-in NLP heuristic parser
GEMINI_API_KEY=your_gemini_api_key_here
