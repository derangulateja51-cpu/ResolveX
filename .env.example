# ResolveX System Environment Variables
# Member 1 & Backend Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/resolvex
JWT_SECRET=resolvex_super_secret_jwt_key_change_in_production
NODE_ENV=development

# Member 5 AI Intake Configuration (Server-Side Only - NEVER expose to browser)
AI_SERVER_PORT=5001
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OPENAI_API_KEY=your_openai_api_key_here

# Frontend Configuration (.env inside /frontend)
VITE_API_URL=http://localhost:5000/api
VITE_AI_URL=http://localhost:5001/api/ai
